[Unit]
Description=Winston Press CMS
After=network.target postgresql.service

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/srv/www/winstonpress
ExecStart=/usr/bin/winstonpress
Restart=on-failure
Environment=WINSTONPRESS_CONFIG=/etc/winstonpress/config

[Install]
WantedBy=multi-user.target
